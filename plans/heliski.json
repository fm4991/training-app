{
  "$schema": "../spec/training-plan.schema.json",
  "specVersion": 1,
  "id": "heliski-2027",
  "title": "Heliski Canada",
  "subtitle": "18-week indoor plan · 30 min Mon–Fri",
  "description": "8–10 runs a day for 7 days is won or lost on day 4+. The plan builds eccentric quad endurance, single-leg strength and an engine, then tapers so you arrive fresh.",
  "startDate": "2026-09-14",
  "notes": [
    "Every session fits in 30 minutes including warm-up and finish. Weekends free.",
    "After a 5-day hotel week, make the next home week's Mon/Wed heavy-backpack days and Tue longer; do not try to make up volume inside the hotel week.",
    "Backpack: on the back for split squats, step-ups, step-downs, calf raises, lunges; on the thighs for wall sits; across the hips for bridges; never on jumps, hops or sprints.",
    "Sunday check (60 s): 5 sessions done? Backpack kg, wall-sit seconds or circuit rounds higher than 3 weeks ago? Two flat weeks in a row means the plan changes.",
    "Same session, same load, RPE dropping over 3 weeks: add load. RPE rising at the same load: you are under-recovered, no extra load.",
    "RPE 1–10: 3–4 easy, could chat · 6–7 hard, 2–3 reps left · 8 very hard, 1 rep left · 9–10 failure (not in this plan)."
  ],
  "equipment": {
    "backpack": { "name": "Backpack 8–15 kg", "description": "Filled with water bottles or books." },
    "chair": { "name": "Sturdy chair", "description": "Test it first. Bed edge works for split squats." },
    "wall": { "name": "Wall" },
    "stairs": { "name": "Stairwell / bench", "description": "2 stairs or a bench for step-ups and step-downs." },
    "rowerg": { "name": "RowErg" }
  },
  "environments": [
    {
      "id": "travel",
      "name": "Hotel",
      "description": "Bodyweight, everything in the room.",
      "equipment": ["chair", "wall"]
    },
    {
      "id": "home",
      "name": "Home",
      "description": "Backpack · stairwell · RowErg.",
      "equipment": ["backpack", "chair", "wall", "stairs", "rowerg"]
    }
  ],
  "phases": [
    {
      "id": "p1",
      "name": "Foundation",
      "weeks": [1, 4],
      "focus": "Movement quality, controlled tempo, 2 reps short of failure.",
      "notes": "Bodyweight or 8 kg. 60 s rest. Wall sit 45 s. Circuit 3 rounds."
    },
    {
      "id": "p2",
      "name": "Strength-endurance",
      "weeks": [5, 10],
      "focus": "Density up: same 4 rounds, rest cut to 30 s, 3 s eccentrics everywhere.",
      "notes": "Pack 10–12 kg. Wall sit 60 s in week 5, +15 s per week, max 2 min. Circuit 4 rounds. Pistol progression."
    },
    {
      "id": "p3",
      "name": "Power + fatigue resistance",
      "weeks": [11, 16],
      "focus": "Plyometrics, working while already tired. Wed–Thu–Fri deliberately back-to-back.",
      "notes": "Pack 15 kg on strength moves only. Jump lunges, hops, tuck jumps. Wall sit 3 min or single-leg. Circuit 4 rounds, 30 s rest. Strongly recommended: 3–4 resort ski days in December."
    },
    {
      "id": "p4",
      "name": "Taper",
      "weeks": [17, 18],
      "focus": "Arrive fresh, not \"one more workout\" tired.",
      "notes": "3 rounds or fewer, same intensity, nothing new. Last hard session about 5 days before the first flight."
    }
  ],
  "exercises": {
    "jumping-jacks": { "name": "Jumping jacks" },
    "leg-swings": { "name": "Leg swings", "instructions": "Front-to-back, hold a wall or chair for balance." },
    "air-squat": { "name": "Air squats", "instructions": "Slow and controlled, full depth, heels down." },
    "lunge": { "name": "Lunges" },
    "single-leg-balance": { "name": "Single-leg balance", "instructions": "Stand on one leg, soft knee, hips level." },
    "hip-circles": { "name": "Hip circles" },
    "marching": { "name": "Marching in place" },
    "easy-movement": {
      "name": "Easy in-room movement",
      "instructions": "Marching, step-jacks, slow chair step-ups. RPE 3–4, you can talk the whole time.",
      "equipment": ["chair"]
    },
    "bulgarian-split-squat": {
      "name": "Bulgarian split squat",
      "instructions": "Rear foot on chair/bed. 3 s down, 1 s up. Front knee over the foot, torso upright. Home: backpack on the back.",
      "cues": ["3 s down, 1 s up", "Front knee over the foot", "Torso upright"],
      "equipment": ["chair"]
    },
    "step-up": {
      "name": "Step-up",
      "instructions": "Onto a chair (hotel) or 2 stairs/bench (home). Drive through the TOP leg, no push-off from the floor. Lower slowly.",
      "cues": ["Drive through the top leg", "No push-off from the floor", "Lower slowly"],
      "equipment": ["chair"]
    },
    "single-leg-glute-bridge": {
      "name": "Single-leg glute bridge",
      "instructions": "Heels close to the glutes, lower back flat, push through the heel. 1 s squeeze at the top, hips level. Never with the pack on the back; home from phase 2 across the hips.",
      "cues": ["Push through the heel", "1 s squeeze at the top", "Hips level"]
    },
    "calf-raise": {
      "name": "Calf raise on an edge",
      "instructions": "Forefoot on a step, thick book or bathroom step edge. 2 s down to a full stretch, 1 s hold at the top. Pressure through the big-toe ball. No edge: flat floor, 2 s pause at the top.",
      "cues": ["2 s down to full stretch", "1 s hold at the top", "Pressure through the big-toe ball"]
    },
    "single-leg-calf-raise": {
      "name": "Single-leg calf raise",
      "instructions": "Like the calf raise on an edge, on one leg. 2 s down to a full stretch, 1 s hold at the top."
    },
    "pistol-progression": {
      "name": "Pistol-squat progression",
      "instructions": "Hold a door frame, lower on one leg as deep as you can control, other leg straight forward. Never with the pack.",
      "cues": ["Hold the door frame", "Only as deep as you control", "Never with the pack"]
    },
    "jump-lunge": {
      "name": "Jump lunges",
      "instructions": "Switch legs in the air, land in a lunge. Land quietly. Never with the pack."
    },
    "single-leg-hop": {
      "name": "Single-leg hops",
      "instructions": "Small and quiet. Never with the pack."
    },
    "rowerg": {
      "name": "RowErg",
      "instructions": "Legs first, then lean, then arms. Drive through the heels. Hard = you could not talk. Easy = full recovery pace.",
      "cues": ["Legs → lean → arms", "Drive through the heels"],
      "equipment": ["rowerg"]
    },
    "stairwell": {
      "name": "Stairwell: up easy, down slow",
      "instructions": "Walk up easy. Walk down slowly on bent knees, 3 s per step, weight controlled by the standing leg. Do NOT jog down; the descent is the point.",
      "cues": ["Up easy", "Down 3 s per step", "Bent knees"],
      "equipment": ["stairs"]
    },
    "fast-chair-step-up": {
      "name": "Fast chair step-ups",
      "instructions": "Alternate legs, fast, full stand at the top. Burpees instead if the chair is shaky. Test the chair first.",
      "equipment": ["chair"],
      "alternatives": [{ "exercise": "burpee", "when": "the chair is shaky" }]
    },
    "burpee": { "name": "Burpees" },
    "chair-step-down": {
      "name": "Slow chair step-downs",
      "instructions": "Stand on the chair on one leg, lower the free heel to the floor over 3 s, tap, back up. This replaces the stairwell descent; do not rush it.",
      "cues": ["3 s lowering", "Tap the heel", "Do not rush"],
      "equipment": ["chair"]
    },
    "step-down": {
      "name": "Step-down",
      "instructions": "Stand on the step on one leg, lower the free heel to the floor over 3 s, tap, drive back up. Knee tracks over the foot, hips level.",
      "cues": ["3 s lowering", "Tap, drive back up", "Knee over the foot"],
      "equipment": ["chair"]
    },
    "wall-sit": {
      "name": "Wall sit",
      "instructions": "Thighs parallel, knees over ankles, weight in the heels, back and head on the wall. The set ends when thighs rise above parallel; log that time. Pack on the thighs, not the back.",
      "cues": ["Thighs parallel", "Knees over ankles", "Back and head on the wall"],
      "equipment": ["wall"],
      "media": [
        {
          "type": "image",
          "alt": "Wall sit stick figure",
          "src": "data:image/svg+xml;base64,"
        }
      ]
    },
    "single-leg-wall-sit": {
      "name": "Single-leg wall sit",
      "instructions": "Wall sit position, extend one leg straight. 30–45 s per side. Closer to skiing than a loaded two-leg sit.",
      "equipment": ["wall"]
    },
    "eccentric-single-leg-squat": {
      "name": "Eccentric single-leg squat to chair",
      "instructions": "Lower on one leg over 3 s until seated, stand up on two legs. Arms forward for balance.",
      "cues": ["3 s down on one leg", "Stand up on two", "Arms forward"],
      "equipment": ["chair"]
    },
    "tuck-jump": {
      "name": "Tuck jumps",
      "instructions": "Knees to chest, land soft and quiet. Loud landings mean stop. Never with the pack."
    },
    "skater-hop": {
      "name": "Skater hops",
      "instructions": "Push off sideways, land on one leg, hold 1 s, knee over toes, no wobble."
    },
    "lateral-lunge": {
      "name": "Lateral lunge",
      "instructions": "Big step to the side, sit back into that hip, other leg straight. Chest up."
    },
    "side-plank": {
      "name": "Side plank",
      "instructions": "Straight line ear–hip–ankle, hips high, top arm to the ceiling."
    },
    "copenhagen-plank": {
      "name": "Copenhagen plank",
      "instructions": "Side plank with the top foot on a chair or bed, bottom leg bent. Squeeze the inner thigh.",
      "equipment": ["chair"]
    },
    "jump-squat": {
      "name": "Jump squats",
      "instructions": "Sit back, explode up, land soft and silent into a quarter squat. Loud landing means you're done."
    },
    "lateral-hop": {
      "name": "Lateral hops",
      "instructions": "Hop side to side over a line or towel, both feet, fast and quiet, knees soft."
    },
    "reverse-lunge": {
      "name": "Reverse lunges",
      "instructions": "Step back, rear knee to just above the floor, front knee over the foot. Alternate legs."
    },
    "mountain-climber": {
      "name": "Mountain climbers",
      "instructions": "Plank, drive knees to chest fast, hips low."
    },
    "stair-sprint": {
      "name": "Stair sprint",
      "instructions": "Sprint up the stairwell, walk down. Never with the pack.",
      "equipment": ["stairs"],
      "alternatives": [{ "exercise": "mountain-climber", "when": "no stairwell" }]
    },
    "hollow-hold": {
      "name": "Hollow hold",
      "instructions": "Lower back pressed into the floor, shoulders and legs lifted, arms overhead. If the back arches, raise the legs."
    },
    "plank": {
      "name": "Plank",
      "instructions": "Forearms, straight line ear–hip–ankle, glutes squeezed, no sagging hips."
    },
    "dead-bug": {
      "name": "Dead bug",
      "instructions": "Lower back pressed flat. Opposite arm and leg lower slowly (2–3 s), exhale on the way out. If the back lifts, shorten the range."
    },
    "deep-squat-hold": {
      "name": "Deep squat hold",
      "instructions": "Heels down, hips loose, knees pushed out with the elbows. Full ankle bend matters more than any stretch."
    },
    "calf-stretch": { "name": "Calf stretch", "instructions": "Hands on the wall, back leg straight, heel down." }
  },
