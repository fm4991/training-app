    {
      "weekday": "tue",
      "title": "Conditioning",
      "subtitle": "Engine + controlled descents",
      "why": "8–10 runs a day needs an aerobic engine; slow, controlled lowering is the closest bodyweight thing to the eccentric load of a long powder run.",
      "log": [
        { "id": "rounds", "label": "Rounds", "type": "number", "autofill": "roundsCompleted", "environments": ["travel"] },
        { "id": "row-metres", "label": "Total row metres", "type": "number", "unit": "m", "environments": ["home"] },
        { "id": "rpe", "label": "RPE", "type": "rpe", "target": [7, 8] }
      ],
      "sessions": [
        {
          "environment": "travel",
          "phases": ["p1"],
          "blocks": [
            {
              "title": "Warm-up",
              "kind": "warmup",
              "items": [
                { "exercise": "marching", "duration": 60 },
                { "exercise": "step-up", "label": "Slow chair step-ups", "duration": 60, "note": "Check the chair is stable." },
                { "exercise": "air-squat", "reps": 10 },
                { "exercise": "leg-swings", "reps": 10, "perSide": true }
              ]
            },
            {
              "title": "Intervals",
              "rounds": 8,
